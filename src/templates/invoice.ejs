<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Invoice <%= invoiceNumber %></title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Segoe UI', Arial, sans-serif;
      font-size: 13px;
      color: #1a1a2e;
      background: #fff;
      padding: 40px;
    }

    .invoice-wrapper {
      max-width: 800px;
      margin: 0 auto;
    }

    /* ── Header ── */
    .invoice-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      padding-bottom: 24px;
      border-bottom: 3px solid #2563eb;
      margin-bottom: 32px;
    }

    .brand h1 {
      font-size: 28px;
      font-weight: 700;
      color: #2563eb;
      letter-spacing: -0.5px;
    }

    .brand p { color: #64748b; font-size: 12px; margin-top: 2px; }

    .invoice-meta { text-align: right; }
    .invoice-meta .invoice-label {
      font-size: 22px;
      font-weight: 700;
      color: #1e293b;
      text-transform: uppercase;
      letter-spacing: 2px;
    }
    .invoice-meta .invoice-number {
      font-size: 14px;
      color: #2563eb;
      font-weight: 600;
      margin-top: 4px;
    }

    .status-badge {
      display: inline-block;
      margin-top: 8px;
      padding: 3px 12px;
      border-radius: 999px;
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.8px;
    }
    .status-DRAFT  { background: #fef9c3; color: #854d0e; }
    .status-SAVED  { background: #dcfce7; color: #166534; }
    .status-SENT   { background: #dbeafe; color: #1e40af; }

    /* ── Parties ── */
    .parties {
      display: flex;
      gap: 40px;
      margin-bottom: 32px;
    }

    .party { flex: 1; }
    .party-label {
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: #94a3b8;
      margin-bottom: 8px;
    }
    .party h3 {
      font-size: 15px;
      font-weight: 600;
      color: #1e293b;
      margin-bottom: 4px;
    }
    .party p { color: #475569; line-height: 1.6; font-size: 12px; }

    /* ── Dates ── */
    .dates-row {
      display: flex;
      gap: 24px;
      margin-bottom: 32px;
    }

    .date-box {
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 8px;
      padding: 12px 20px;
    }
    .date-box .date-label {
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: #94a3b8;
      margin-bottom: 4px;
    }
    .date-box .date-value { font-size: 14px; font-weight: 600; color: #1e293b; }

    /* ── Line Items Table ── */
    .line-items { width: 100%; border-collapse: collapse; margin-bottom: 24px; }

    .line-items thead tr {
      background: #2563eb;
      color: #fff;
    }
    .line-items thead th {
      padding: 10px 14px;
      text-align: left;
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.8px;
    }
    .line-items thead th:last-child,
    .line-items thead th:nth-child(2),
    .line-items thead th:nth-child(3) { text-align: right; }

    .line-items tbody tr { border-bottom: 1px solid #f1f5f9; }
    .line-items tbody tr:nth-child(even) { background: #f8fafc; }
    .line-items tbody td { padding: 10px 14px; font-size: 13px; color: #334155; }
    .line-items tbody td:last-child,
    .line-items tbody td:nth-child(2),
    .line-items tbody td:nth-child(3) { text-align: right; }

    /* ── Totals ── */
    .totals-section {
      display: flex;
      justify-content: flex-end;
      margin-bottom: 32px;
    }

    .totals-table { width: 300px; }
    .totals-row {
      display: flex;
      justify-content: space-between;
      padding: 6px 0;
      font-size: 13px;
      color: #475569;
      border-bottom: 1px solid #f1f5f9;
    }
    .totals-row.grand {
      margin-top: 8px;
      padding: 10px 14px;
      background: #2563eb;
      color: #fff;
      border-radius: 8px;
      font-size: 15px;
      font-weight: 700;
      border-bottom: none;
    }
    .totals-row .label { font-weight: 500; }
    .totals-row .value { font-weight: 600; }

    /* ── Notes ── */
    .notes-section {
      background: #f8fafc;
      border-left: 4px solid #2563eb;
      border-radius: 4px;
      padding: 14px 18px;
      margin-bottom: 32px;
    }
    .notes-section .notes-label {
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: #94a3b8;
      margin-bottom: 6px;
    }
    .notes-section p { color: #475569; font-size: 12px; line-height: 1.6; }

    /* ── Footer ── */
    .invoice-footer {
      text-align: center;
      padding-top: 24px;
      border-top: 1px solid #e2e8f0;
      color: #94a3b8;
      font-size: 11px;
    }
  </style>
</head>
<body>
  <div class="invoice-wrapper">

    <!-- Header -->
    <div class="invoice-header">
      <div class="brand">
        <h1>Smart Invoicer</h1>
        <p>Invoice Management Platform</p>
      </div>
      <div class="invoice-meta">
        <div class="invoice-label">Invoice</div>
        <div class="invoice-number">#<%= invoiceNumber %></div>
        <span class="status-badge status-<%= status %>"><%= status %></span>
      </div>
    </div>

    <!-- Parties -->
    <div class="parties">
      <div class="party">
        <div class="party-label">Bill To</div>
        <h3><%= clientName %></h3>
        <p><%= clientEmail %></p>
        <% if (clientAddress) { %><p><%= clientAddress %></p><% } %>
        <% if (clientPhone) { %><p><%= clientPhone %></p><% } %>
      </div>
    </div>

    <!-- Dates -->
    <div class="dates-row">
      <div class="date-box">
        <div class="date-label">Issue Date</div>
        <div class="date-value"><%= new Date(issueDate).toLocaleDateString('en-GB', { day: '2-digit', month: 'long', year: 'numeric' }) %></div>
      </div>
      <div class="date-box">
        <div class="date-label">Due Date</div>
        <div class="date-value"><%= new Date(dueDate).toLocaleDateString('en-GB', { day: '2-digit', month: 'long', year: 'numeric' }) %></div>
      </div>
      <div class="date-box">
        <div class="date-label">Currency</div>
        <div class="date-value"><%= currency %></div>
      </div>
    </div>

    <!-- Line Items -->
    <table class="line-items">
      <thead>
        <tr>
          <th>#</th>
          <th style="width:45%">Description</th>
          <th>Qty</th>
          <th>Unit Price</th>
          <th>Total</th>
        </tr>
      </thead>
      <tbody>
        <% lineItems.forEach(function(item, idx) { %>
        <tr>
          <td><%= idx + 1 %></td>
          <td><%= item.description %></td>
          <td><%= item.quantity %></td>
          <td><%= item.unitPriceFormatted %></td>
          <td><%= item.totalFormatted %></td>
        </tr>
        <% }); %>
      </tbody>
    </table>

    <!-- Totals -->
    <div class="totals-section">
      <div class="totals-table">
        <div class="totals-row">
          <span class="label">Subtotal</span>
          <span class="value"><%= subtotalFormatted %></span>
        </div>
        <div class="totals-row">
          <span class="label">Tax (<%= taxRateFormatted %>)</span>
          <span class="value"><%= taxAmountFormatted %></span>
        </div>
        <% if (discount > 0) { %>
        <div class="totals-row">
          <span class="label">Discount</span>
          <span class="value">-<%= discountFormatted %></span>
        </div>
        <% } %>
        <div class="totals-row grand">
          <span class="label">Grand Total</span>
          <span class="value"><%= grandTotalFormatted %></span>
        </div>
      </div>
    </div>

    <!-- Notes -->
    <% if (notes) { %>
    <div class="notes-section">
      <div class="notes-label">Notes</div>
      <p><%= notes %></p>
    </div>
    <% } %>

    <!-- Footer -->
    <div class="invoice-footer">
      <p>Thank you for your business &mdash; Generated by Smart Invoicer</p>
    </div>

  </div>
</body>
</html>
